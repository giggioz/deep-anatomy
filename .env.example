# Server di Deep Anatomy (apps/server). Copia questo file in .env e compila.
# Senza chiave l'app funziona lo stesso: "Importa diagnosi" usa solo i referti di esempio.
# La chiave resta sul server: non finisce mai nel browser.
ANTHROPIC_API_KEY=
# Modello usato per interpretare i referti importati (testo, foto o PDF)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Porta del server (la web app in sviluppo la legge da qui per il proxy di /api)
PORT=8787
# 127.0.0.1 = raggiungibile solo da questo computer. 0.0.0.0 per provarla da un tablet sulla stessa rete.
HOST=127.0.0.1

# --- Accesso dei medici ---
# Database degli account e delle sessioni. In sviluppo: npm run db (Mongo locale con i dati in .mongo/).
MONGO_URI=mongodb://127.0.0.1:27027/deep_anatomy
# Indirizzo pubblico dell'app: serve per i link nelle email e per il cookie Secure (https).
# In sviluppo è la web app di Vite.
URL_APP=http://localhost:5173
# Email (invito, recupero password). Vuoto = le email non partono e il link si legge nel log del server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@infinitymundi.it
