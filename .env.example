# Server di Deep Anatomy (apps/server). Copia questo file in .env e compila.
# Senza chiave l'app funziona lo stesso: "Importa diagnosi" usa solo i referti di esempio.
# La chiave resta sul server: non finisce mai nel browser.
ANTHROPIC_API_KEY=
# Modello usato per interpretare i referti importati (testo, foto o PDF)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Porta del server (la web app in sviluppo la legge da qui per il proxy di /api)
PORT=8787
# 127.0.0.1 = raggiungibile solo da questo computer. 0.0.0.0 per provarla da un tablet sulla stessa rete.
HOST=127.0.0.1
